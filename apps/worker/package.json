{
  "name": "@ceefex/worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@ceefex/core": "workspace:*"
  },
  "scripts": {
    "types": "wrangler types",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsx ../../scripts/build/index.ts",
    "dev": "wrangler dev",
    "dev:preview": "wrangler dev --env preview",
    "deploy": "wrangler deploy --config wrangler.deploy.jsonc --env=\"\"",
    "deploy:preview": "wrangler deploy --config wrangler.deploy.jsonc --env preview"
  }
}
