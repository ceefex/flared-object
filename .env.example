# Copy this file to .env and replace the sample values with your Cloudflare resources.
DEPLOY_WORKER_NAME=flared-object-worker
DEPLOY_WORKER_PREVIEW_NAME=flared-object-worker-preview
DEPLOY_R2_BUCKET_NAME=replace-with-your-production-r2-bucket
DEPLOY_R2_PREVIEW_BUCKET_NAME=replace-with-your-named-preview-r2-bucket
DEPLOY_R2_BUILDS_PREVIEW_BUCKET_NAME=replace-with-your-builds-preview-r2-bucket
DEPLOY_R2_LOCAL_BUCKET_NAME=flared-object-local-development
